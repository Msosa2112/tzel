{
  "version": 2,
  "builds": [
    {
      "src": "tzel_map_server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "lands.html",
      "use": "@vercel/static"
    },
    {
      "src": "logo.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "zillow-icon.png",
      "use": "@vercel/static"
    },
    {
      "src": "street-view-icon.png",
      "use": "@vercel/static"
    },
    {
      "src": "underwriting/offer_engine.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "tzel_map_server.ts"
    },
    {
      "src": "/lands",
      "dest": "lands.html"
    },
    {
      "src": "/lands.html",
      "dest": "lands.html"
    },
    {
      "src": "/terrenos",
      "dest": "lands.html"
    },
    {
      "src": "/terrenos.html",
      "dest": "lands.html"
    },
    {
      "src": "/logo.jpg",
      "dest": "logo.jpg"
    },
    {
      "src": "/zillow-icon.png",
      "dest": "zillow-icon.png"
    },
    {
      "src": "/street-view-icon.png",
      "dest": "street-view-icon.png"
    },
    {
      "src": "/offer_engine.js",
      "dest": "underwriting/offer_engine.js"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}
